DirectoryIndex index.html

<FilesMatch "^contact-config.*\.php$">
  Require all denied
</FilesMatch>

# Fichiers sensibles : config locale, donnees sources, exports
<FilesMatch "\.(sql|xlsx|xls|csv|zip)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.local\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.gbg-ci\.com$ [NC]
  RewriteRule ^ https://gbg-ci.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Compression des ressources textuelles pour accélérer l'affichage et l'exploration.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
