DirectoryIndex index.html

<FilesMatch "^contact-config.*\.php$">
  Require all denied
</FilesMatch>

# Fichiers sensibles : config locale, donnees sources, exports
<FilesMatch "\.(sql|xlsx|xls|csv)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.local\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.gbg-ci\.com$ [NC]
  RewriteRule ^ https://gbg-ci.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
